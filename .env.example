# Port the Node server listens on (Nginx proxies to this)
PORT=3000

# Public base URL of the app (used in share links, embed codes, emails).
# Also controls whether admin cookies are marked "secure" (only over HTTPS) —
# leave this unset for local dev over http://localhost.
PUBLIC_URL=https://score.blta.sk

# The password for the single admin account (add/edit/delete players, edit a
# finished match). Pick something you'll remember; there's no username, just
# this password, entered at /admin.
ADMIN_PASSWORD=changeme-admin-password

# Player login doesn't use a shared code — each player logs in with their
# own phone number (set per-player on the Players page, admin only) plus a
# 5-digit code they create on first login. There's nothing to configure
# here for it. (There used to be a second, more limited shared-code login
# tier for anyone without a real BLTA player account — it's been removed
# entirely; a phone number on file is now the only way in besides admin.)

# Random string used to sign the admin login cookie so it can't be forged.
# Any long random value works — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changeme-generate-a-random-value

# SMTP settings used to send the "match finished" notification email.
# Using the blta.sk mailbox (score@blta.sk) via WebSupport's mail server —
# find these under WebAdmin -> your mailbox -> Prihlasovacie údaje.
SMTP_HOST=smtp.m1.websupport.sk
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=score@blta.sk
SMTP_PASS=changeme-mailbox-password
# Where the notification email is sent TO (can be a different address than
# SMTP_USER above) — also where a "please reset my login code" request
# lands when a player has no email on file (see POST /player/request-admin-reset).
NOTIFY_EMAIL=robert.sloboda@gmail.com
MAIL_FROM="BLTA Score <score@blta.sk>"

# Web push (browser notifications for "match started"/"match finished").
# Generate a key pair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# then set the same pair here and on the server — VAPID_PUBLIC_KEY is also
# sent to the browser, VAPID_PRIVATE_KEY must stay secret.
VAPID_PUBLIC_KEY=changeme-vapid-public-key
VAPID_PRIVATE_KEY=changeme-vapid-private-key
VAPID_SUBJECT=mailto:score@blta.sk
