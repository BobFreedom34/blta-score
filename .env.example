# Port the Node server listens on (Nginx proxies to this)
PORT=3000

# Public base URL of the app (used in share links, embed codes, emails)
PUBLIC_URL=https://score.blta.sk

# SMTP settings used to send the "match finished" notification email.
# For Gmail: enable 2-Step Verification on the account, then create an
# "App Password" at https://myaccount.google.com/apppasswords and use it
# below (NOT the normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=robert.sloboda@gmail.com
SMTP_PASS=changeme-app-password
NOTIFY_EMAIL=robert.sloboda@gmail.com
MAIL_FROM="BLTA Score <robert.sloboda@gmail.com>"
