# Port the Node server listens on (Nginx proxies to this)
PORT=3000

# Public base URL of the app (used in share links, embed codes, emails).
# Also controls whether admin cookies are marked "secure" (only over HTTPS) —
# leave this unset for local dev over http://localhost.
PUBLIC_URL=https://score.blta.sk

# The password for the single admin account (add/edit/delete players, edit a
# finished match). Pick something you'll remember; there's no username, just
# this password, entered at /admin.
ADMIN_PASSWORD=changeme-admin-password

# Player login no longer uses a shared code — each player logs in with
# their own phone number (set per-player on the Players page, admin only).
# There's nothing to configure here for it.

# A second, more limited shared code — for anyone without a real BLTA player
# code (advertised in the login popup itself). Logging in with it can still
# create a match and manage it fully, but ONLY matches created this way —
# it has no access to matches created by a real player or admin.
ANON_CODE=3344

# Random string used to sign the admin login cookie so it can't be forged.
# Any long random value works — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changeme-generate-a-random-value

# SMTP settings used to send the "match finished" notification email.
# Using the blta.sk mailbox (score@blta.sk) via WebSupport's mail server —
# find these under WebAdmin -> your mailbox -> Prihlasovacie údaje.
SMTP_HOST=smtp.m1.websupport.sk
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=score@blta.sk
SMTP_PASS=changeme-mailbox-password
# Where the notification email is sent TO (can be a different address than SMTP_USER above).
NOTIFY_EMAIL=robert.sloboda@gmail.com
MAIL_FROM="BLTA Score <score@blta.sk>"

# Web push (browser notifications for "match started"/"match finished").
# Generate a key pair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# then set the same pair here and on the server — VAPID_PUBLIC_KEY is also
# sent to the browser, VAPID_PRIVATE_KEY must stay secret.
VAPID_PUBLIC_KEY=changeme-vapid-public-key
VAPID_PRIVATE_KEY=changeme-vapid-private-key
VAPID_SUBJECT=mailto:score@blta.sk

# Nightly backup (database + uploaded badge icons + a snapshot of the code)
# to a Google Drive folder — see src/backup.js. Both unset (the default)
# just disables the feature entirely; nothing else needs it.
#
# 1. console.cloud.google.com -> create/pick a project -> enable the
#    "Google Drive API".
# 2. APIs & Services -> Credentials -> Create Credentials -> Service
#    Account. Give it any name, no roles needed. Open it -> Keys -> Add
#    Key -> Create new key -> JSON, and download it.
# 3. Paste that JSON file's *entire contents* as one line here (or as this
#    exact env var on Render).
# 4. In your own Google Drive, make a folder for the backups, share it with
#    the service account's email (the "client_email" field in the JSON —
#    looks like ...@...iam.gserviceaccount.com) as Editor.
# 5. Open that folder in Drive, copy the id from its URL
#    (drive.google.com/drive/folders/<THIS PART>).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
