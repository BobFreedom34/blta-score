# Port the Node server listens on (Nginx proxies to this)
PORT=3000

# Public base URL of the app (used in share links, embed codes, emails).
# Also controls whether admin cookies are marked "secure" (only over HTTPS) —
# leave this unset for local dev over http://localhost.
PUBLIC_URL=https://score.blta.sk

# The password for the single admin account (add/edit/delete players, edit a
# finished match). Pick something you'll remember; there's no username, just
# this password, entered at /admin.
ADMIN_PASSWORD=changeme-admin-password

# Player login doesn't use a shared code — each player logs in with their
# own phone number (set per-player on the Players page, admin only) plus a
# 5-digit code they create on first login. There's nothing to configure
# here for it. (There used to be a second, more limited shared-code login
# tier for anyone without a real BLTA player account — it's been removed
# entirely; a phone number on file is now the only way in besides admin.)

# Random string used to sign the admin login cookie so it can't be forged.
# Any long random value works — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changeme-generate-a-random-value

# SMTP settings used to send the "match finished" notification email.
# Using the blta.sk mailbox (score@blta.sk) via WebSupport's mail server —
# find these under WebAdmin -> your mailbox -> Prihlasovacie údaje.
SMTP_HOST=smtp.m1.websupport.sk
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=score@blta.sk
SMTP_PASS=changeme-mailbox-password
# Where the notification email is sent TO (can be a different address than
# SMTP_USER above) — also where a "please reset my login code" request
# lands when a player has no email on file (see POST /player/request-admin-reset).
NOTIFY_EMAIL=robert.sloboda@gmail.com
MAIL_FROM="BLTA Score <score@blta.sk>"

# Web push (browser notifications for "match started"/"match finished").
# Generate a key pair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# then set the same pair here and on the server — VAPID_PUBLIC_KEY is also
# sent to the browser, VAPID_PRIVATE_KEY must stay secret.
VAPID_PUBLIC_KEY=changeme-vapid-public-key
VAPID_PRIVATE_KEY=changeme-vapid-private-key
VAPID_SUBJECT=mailto:score@blta.sk

# Daily off-site backup of the database to a Google Drive folder — the
# persistent disk on Render survives redeploys, but has no backup of its
# own, so this is the real disaster-recovery story for match/player data.
# Leave these unset to leave backups off entirely (local dev doesn't need
# this).
#
# Uses OAuth2 as your own Google account, NOT a service account — Drive
# gives service accounts zero storage quota on a personal (non-Workspace)
# account, so they can't own files even in a folder shared with them
# (fails with "storageQuotaExceeded"). Setup, once:
#   1. console.cloud.google.com -> New Project (any name, e.g. "blta-score").
#   2. APIs & Services -> Library -> enable "Google Drive API".
#   3. APIs & Services -> OAuth consent screen -> External -> fill in the
#      required fields (app name, your email) -> Save. Then on the same
#      page, set Publishing status to "In production" (a plain button, no
#      Google review needed for the drive.file scope used here) — skipping
#      this leaves the app in "Testing", where refresh tokens for external
#      users expire after 7 days and this would silently stop working.
#   4. APIs & Services -> Credentials -> Create Credentials -> OAuth client
#      ID -> Application type "Desktop app" (any name). Note the Client ID
#      and Client secret it shows you — these are GOOGLE_OAUTH_CLIENT_ID
#      and GOOGLE_OAUTH_CLIENT_SECRET below.
#   5. Still on that client, add an "Authorized redirect URI":
#      http://127.0.0.1:53682
#   6. In Google Drive, make a folder for backups (e.g. "BLTA Score
#      Backups"). Open it in a browser; the last part of the URL
#      (drive.google.com/drive/folders/<THIS PART>) is
#      GOOGLE_DRIVE_BACKUP_FOLDER_ID below.
#   7. Run once, on your own machine (not on the server):
#        node scripts/get-drive-refresh-token.js <CLIENT_ID> <CLIENT_SECRET>
#      Open the URL it prints, log into the Google account you want
#      backups saved to, click Allow. The script prints a refresh token —
#      that's GOOGLE_OAUTH_REFRESH_TOKEN below.
# Files land directly in your own Drive, in that folder, as
# blta-score-backup-YYYY-MM-DD.db — a restore is just downloading the
# latest one and dropping it in as blta-score.db on the new server.
GOOGLE_OAUTH_CLIENT_ID=changeme-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=changeme-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=changeme-refresh-token-from-the-script-above
GOOGLE_DRIVE_BACKUP_FOLDER_ID=changeme-drive-folder-id
# How many days of backups to keep in Drive before older ones are pruned —
# one file/day means this is just "keep the last N days". Optional.
BACKUP_RETENTION_DAYS=30
